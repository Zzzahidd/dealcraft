{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dealcraft",
  "version": "1.0.0",
  "identifier": "com.dealcraft.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dealcraft",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": false
      },
      {
        "label": "spotlight",
        "title": "Dealcraft Spotlight",
        "url": "spotlight.html",
        "width": 640,
        "height": 480,
        "minWidth": 440,
        "minHeight": 300,
        "center": true,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "Dealcraft",
        "displayLanguageSelector": false
      }
    }
  }
}
